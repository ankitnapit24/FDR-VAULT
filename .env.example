# FDRFlow - AICTE Security Deposit / FDR Portal Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas URI; falls back to self-contained in-memory MongoDB automatically)
MONGODB_URI=mongodb://localhost:27017/fdrflow

# JWT Authentication
JWT_SECRET=fdrflow_aicte_secure_portal_key_2026_demo
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Workflow Reminders (Days prior to maturity)
REMINDER_DAYS_BEFORE=30,15,7
OVERDUE_DAYS_THRESHOLD=14
CRON_SCHEDULE=0 8 * * *
