# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Fallback embedded in-memory MongoDB will be used automatically if unreachable)
MONGODB_URI=mongodb://localhost:27017/fdrflow

# JWT Authentication
JWT_SECRET=fdrflow_secure_jwt_secret_aicte_key_2026_replace_in_prod
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Workflow & Reminders
REMINDER_DAYS_BEFORE=30,15,7
OVERDUE_DAYS_THRESHOLD=14
CRON_SCHEDULE=0 8 * * *

# Optional AI / OCR Services (Falls back to local Tesseract.js / Rule-engine)
TESSERACT_LANG=eng
