# ==============================================================================
# FDRFlow — AICTE Security Deposit & FDR Management Portal
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Server Environment
NODE_ENV=production
PORT=5000

# 2. Production Database: MongoDB Atlas Cluster Connection String
# Replace with your actual MongoDB Atlas cluster credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fdrflow_production?retryWrites=true&w=majority&appName=AICTE-FDRFlow

# 3. Authentication & JWT Security
# Generate a cryptographically secure 256-bit random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_real_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# 4. CORS Whitelisting
# Set to your exact production frontend domain to block unauthorized cross-origin requests
CORS_ORIGIN=https://fdrflow.aicte-india.org,https://fdrflow.onrender.com

# 5. Cloud Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# Set STORAGE_DRIVER=s3 to store documents in cloud object storage; or leave STORAGE_DRIVER=local
STORAGE_DRIVER=s3
S3_REGION=ap-south-1
S3_BUCKET=aicte-fdrflow-documents-production
S3_ACCESS_KEY_ID=AKIA_YOUR_PRODUCTION_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_PRODUCTION_SECRET_ACCESS_KEY
# Optional S3 Custom Endpoint (Required for Cloudflare R2 or MinIO)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false

# 6. File Limits
MAX_FILE_SIZE_MB=10

# 7. Workflow & Monitoring Schedules
REMINDER_DAYS_BEFORE=30,15,7
OVERDUE_DAYS_THRESHOLD=14
CRON_SCHEDULE=0 8 * * *

# 8. Database Seeding Control
# Set to true ONLY if you want to seed demo institutions & accounts on first launch
AUTO_SEED=false
